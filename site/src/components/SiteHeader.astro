---
import { STORE_URL, REPO_URL } from '../lib/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<header class="site-header">
  <a class="brand" href={`${base}/`}>
    <img src={`${base}/assets/icon_256.png`} alt="" width="26" height="26" /> Laydown
  </a>
  <nav class="anchors" aria-label="Sections">
    <a href={`${base}/#features`}>Features</a>
    <a href={`${base}/#how`}>How it works</a>
    <a href={`${base}/#faq`}>FAQ</a>
  </nav>
  <div class="actions">
    <a class="btn" href={STORE_URL} aria-label="Get Laydown on the Microsoft Store"><img class="store-logo" src="/ms-store.svg" alt="" width="18" height="18" />Microsoft Store</a>
    <a class="gh" href={REPO_URL} aria-label="Source code on GitHub" title="Source code on GitHub">
      <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
    </a>
  </div>
</header>

<style>
  .site-header {
    display: flex; align-items: center; gap: 1rem;
    padding: 1rem clamp(16px, 4vw, 64px);
  }
  .brand {
    display: flex; align-items: center; gap: 0.6rem;
    font-weight: 700; color: var(--heading); text-decoration: none; font-size: 1.15rem;
  }
  .brand img { width: 26px; height: 26px; border-radius: 6px; flex: none; }
  .anchors { display: flex; gap: 1.3rem; margin-left: auto; }
  .anchors a { color: var(--muted); text-decoration: none; font-weight: 500; font-size: 0.95rem; }
  .anchors a:hover { color: var(--heading); }
  .actions { display: flex; align-items: center; gap: 0.6rem; margin-left: 1rem; }
  .btn {
    display: inline-flex; align-items: center;
    background: var(--accent); color: #141414;
    padding: 0.6rem 1.1rem; border-radius: 999px;
    font-weight: 600; font-size: 0.92rem; text-decoration: none; white-space: nowrap;
  }
  .btn:hover { background: var(--accent-hi); }
  .btn { gap: 8px; }
  .store-logo { display: block; width: 18px; height: 18px; flex: none; }
  .gh {
    display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%;
    color: var(--text); border: 1px solid var(--border);
  }
  .gh:hover { color: var(--heading); border-color: var(--muted); }
  @media (max-width: 760px) {
    .anchors { display: none; }
    .actions { margin-left: auto; }
  }
</style>
